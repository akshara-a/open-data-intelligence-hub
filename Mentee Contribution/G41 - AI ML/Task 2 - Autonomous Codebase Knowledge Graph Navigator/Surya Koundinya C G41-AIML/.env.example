# Copy to .env and fill in. NEVER commit .env
KGNAV_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_key_here

# Free-tier quotas are PER MODEL. Many-call investigation loop -> Flash-Lite (large daily allowance);
# report writing (2-3 calls) -> stronger Flash. Run `kgnav doctor` to confirm these IDs exist for your key.
KGNAV_MODEL_INVESTIGATE=gemini-3.5-flash-lite
KGNAV_MODEL_SYNTH=gemini-3.8-flash
# If the report model is overloaded (503) / out of quota, these are tried in order (default: the investigation model)
# KGNAV_SYNTH_FALLBACKS=gemini-3.5-flash-lite
# KGNAV_MODEL=...   # optional: one model for both phases
KGNAV_SYNTH_MAX_TOKENS=16000

# Free-tier friendliness: wait this many seconds between requests (5 RPM => 12), retry count on 429/5xx
GEMINI_MIN_INTERVAL_S=0
GEMINI_MAX_RETRIES=6   # exponential backoff with jitter (~2 min total); note: pacing helps 429, not 503

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kgnav-password
NEO4J_DATABASE=neo4j

KGNAV_MAX_ROWS=500
KGNAV_QUERY_TIMEOUT_S=20
KGNAV_MAX_STEPS=12
KGNAV_GROUNDING_RETRIES=2
