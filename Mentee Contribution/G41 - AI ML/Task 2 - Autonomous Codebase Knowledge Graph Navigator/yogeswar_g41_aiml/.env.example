# ============================================================================
# Autonomous Codebase Knowledge Graph Navigator
# Production Environment Configuration Template
# ============================================================================

# Domain and Hosting
DOMAIN_NAME=kg-navigator.enterprise.internal
APP_ENV=production
LOG_LEVEL=INFO

# CORS Configuration (Tailscale Funnel public HTTPS FQDN once generated)
# Localhost origins (http://localhost, http://127.0.0.1) are always enabled by default.
CORS_ALLOWED_ORIGINS=https://kg-navigator.enterprise.internal

# Authentication Cookie Security (set to true for public HTTPS deployment)
COOKIE_SECURE=true

# Security & Secrets Paths (Must be mounted via Docker Secrets / Kubernetes Secrets)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_rs256_private_key
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_rs256_public_key
NEO4J_PASSWORD_FILE=/run/secrets/neo4j_admin_password
INTERNAL_SERVICE_SECRET_FILE=/run/secrets/internal_service_secret

# Core Services
SQLITE_DB_PATH=/app/data/app_state.db
NEO4J_BOLT_URL=bolt://neo4j:7687
NEO4J_USER=neo4j

# Inter-Service Network Endpoints (Internal Docker Network)
MCP_SERVICE_URL=http://mcp:8000
RAG_SERVICE_URL=http://rag:8000
BACKEND_SERVICE_URL=http://backend:8000

# GraphRAG & Embedding Model Settings
EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
FORCE_OFFLINE_FALLBACK=false

# LLM Provider Configuration
# Set to 'openai' or 'anthropic' for production deployment with real credentials.
# Default is 'mock' for fully isolated offline development/evaluation.
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Resource Constraints & Performance Limits
MAX_GRAPH_HOPS=3
HARD_ROW_LIMIT=500
QUERY_TIMEOUT_SECONDS=15.0
MAX_TOOL_CALLS_PER_REQUEST=9

# Worker & Queue
CELERY_BROKER_URL=sqlite:///app/data/celery_broker.db
INGESTION_CONCURRENCY=2
