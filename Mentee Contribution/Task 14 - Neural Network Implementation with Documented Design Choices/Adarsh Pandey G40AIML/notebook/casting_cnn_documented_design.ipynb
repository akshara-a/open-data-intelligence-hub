   "source": [
    "# Casting Product CNN Classifier\n",
    "## Neural Network Implementation with Documented Design Choices\n",
    "\n",
    "This notebook trains a binary CNN classifier to detect defects in casting product images.\n",
    "Every design decision (architecture, hyperparameters, augmentation) is documented with its rationale."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Import Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from PIL import Image\n",
    "from sklearn.metrics import confusion_matrix, classification_report\n",
    "\n",
    "import tensorflow as tf\n",
    "from tensorflow.keras import layers, models, callbacks\n",
n",
    "from tensorflow.keras.preprocessing.image import ImageDataGenerator\n",
    "\n",
    "print(f\"TensorFlow version: {tf.__version__}\")\n",
    "print(f\"GPU Available: {len(tf.config.list_physical_devices('GPU')) > 0}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Configuration & Design Decisions\n",
    "\n",
    "All hyperparameters are defined in one place with rationale comments."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ===== DESIGN DECISIONS =====\n",
    "\n",
    "# Input Configuration\n",
    "IMG_SIZE = 224  # Balance between detail and computation\n",
    "BATCH_SIZE = 32  # Memory-efficient; stable gradients\n",
    "\n",
    "# Model Architecture\n",
    "CONV_FILTERS = [32, 64, 128]  # Progressive feature hierarchy\n",
    "KERNEL_SIZE = (3, 3)  # Efficient local feature extraction\n",
    "POOL_SIZE = (2, 2)  # MaxPooling: reduces dims, preserves strong features\n",
    "DROPOUT_RATE = 0.40  # Regularization: helps reduce overfitting\n",
    "\n",
    "# Training Configuration\n",
    "OPTIMIZER = 'adam'  # Adaptive learning rates; robust and beginner-friendly\n",
    "LEARNING_RATE = 0.001  # Adam default; prevents overshooting\n",
    "LOSS_FN = 'binary_crossentropy'  # Theoretically optimal for binary classification\n",
    "EPOCHS = 25  # Maximum epochs; early stopping will likely stop earlier\n",
    "EARLY_STOP_PATIENCE = 5  # Halt if validation loss doesn't improve for 5 epochs\n",
    "\n",
    "# Paths\n",
    "DATA_DIR = '../casting_data'\n",
    "TRAIN_DIR = os.path.join(DATA_DIR, 'train')\n",
    "TEST_DIR = os.path.join(DATA_DIR, 'test')\n",
    "MODEL_SAVE_PATH = '../models/casting_cnn_documented.keras'\n",
    "REPORTS_DIR = '../reports'\n",
    "\n",
    "# Create reports directory if it doesn't exist\n",
    "os.makedirs(REPORTS_DIR, exist_ok=True)\n",
    "\n",
    "print(\"✓ Configuration loaded\")\n",
    "print(f\"  Image size: {IMG_SIZE}×{IMG_SIZE}\")\n",
    "print(f\"  Batch size: {BATCH_SIZE}\")\n",
    "print(f\"  Conv filters: {CONV_FILTERS}\")\n",
    "print(f\"  Dropout: {DROPOUT_RATE}\")\n",
    "print(f\"  Learning rate: {LEARNING_RATE}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Load & Explore Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Count images in train and test directories\n",
    "train_ok = len(os.listdir(os.path.join(TRAIN_DIR, 'ok_front'))) if os.path.exists(os.path.join(TRAIN_DIR, 'ok_front')) else 0\n",
    "train_def = len(os.listdir(os.path.join(TRAIN_DIR, 'def_front'))) if os.path.exists(os.path.join(TRAIN_DIR, 'def_front')) else 0\n",
    "test_ok = len(os.listdir(os.path.join(TEST_DIR, 'ok_front'))) if os.path.exists(os.path.join(TEST_DIR, 'ok_front')) else 0\n",
    "test_def = len(os.listdir(os.path.join(TEST_DIR, 'def_front'))) if os.path.exists(os.path.join(TEST_DIR, 'def_front')) else 0\n",
    "\n",
    "print(f\"Train data:\")\n",
    "print(f\"  Non-defective: {train_ok}\")\n",
    "print(f\"  Defective: {train_def}\")\n",
    "print(f\"  Total: {train_ok + train_def}\")\n",
    "print()\n",
    "print(f\"Test data:\")\n",
    "print(f\"  Non-defective: {test_ok}\")\n",
    "print(f\"  Defective: {test_def}\")\n",
    "print(f\"  Total: {test_ok + test_def}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Data Augmentation\n",
    "\n",
    "**Augmentation Rationale:**\n",
    "- Horizontal/Vertical Flip: Casting defects are rotationally symmetric\n",
    "- Rotation (±15°): Casting may be tilted during capture\n",
    "- Zoom (0.8–1.2×): Mimics different camera distances\n",
    "- Contrast (0.8–1.2×): Accounts for lighting variations in factory"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Training data augmentation\n",
    "train_datagen = ImageDataGenerator(\n",
    "    rescale=1./255,\n",
    "    horizontal_flip=True,\n",
    "    vertical_flip=True,\n",
    "    rotation_range=15,\n",
    "    zoom_range=0.2,\n",
    "    brightness_range=[0.8, 1.2],\n",
    "    fill_mode='nearest'\n",
    ")\n",
    "\n",
    "# Test/validation data (no augmentation, only rescaling)\n",
    "test_datagen = ImageDataGenerator(rescale=1./255)\n",
    "\n",
    "print(\"✓ Data augmentation pipelines created\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Create Data Generators"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    # Training data generator\n",
    "    train_generator = train_datagen.flow_from_directory(\n",
    "        TRAIN_DIR,\n",
    "        target_size=(IMG_SIZE, IMG_SIZE),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        class_mode='binary',  # Binary classification: 0=ok_front, 1=def_front\n",
    "        shuffle=True\n",
    "    )\n",
    "    \n",
    "    # Validation data generator (split from train if possible, or use separate fold)\n",
    "    # For now, use test as validation; ideally split train into train/val\n",
    "    val_generator = test_datagen.flow_from_directory(\n",
    "        TEST_DIR,\n",
    "        target_size=(IMG_SIZE, IMG_SIZE),\n",
    "        batch_size=BATCH_SIZE,\n",
    "        class_mode='binary',\n",
    "        shuffle=False\n",
    "    )\n",
    "    \n",
    "    print(f\"✓ Train generator: {train_generator.n} images\")\n",
    "    print(f\"✓ Validation generator: {val_generator.n} images\")\n",
    "    print(f\"  Class indices: {train_generator.class_indices}\")\n",
    "    \nexcept Exception as e:\n",
    "    print(f\"⚠ Error loading data: {e}\")\n",
    "    print(f\"  Make sure {TRAIN_DIR} and {TEST_DIR} exist with subdirectories 'ok_front' and 'def_front'\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Build CNN Model\n",
    "\n",
    "**Architecture Rationale:**\n",
    "- **Input:** 224×224×3 images\n",
    "- **Conv blocks:** 32→64→128 filters (progressive feature hierarchy)\n",
    "- **Kernels:** 3×3 (efficient local feature extraction)\n",
    "- **Activation:** ReLU (efficient, prevents vanishing gradients)\n",
    "- **Pooling:** MaxPooling 2×2 (reduces dimensions, preserves strong features)\n",
    "- **Dense layers:** Flattened features → 128 hidden neurons → 1 output\n",
    "- **Output:** Sigmoid (produces binary probability)\n",
    "- **Regularization:** Dropout 0.40 (prevents overfitting)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_model(img_size, conv_filters, dropout_rate):\n",
    "    \"\"\"\n",
    "    Build CNN model with documented architecture.\n",
    "    \n",
    "    Args:\n",
    "        img_size: Input image size (square)\n",
    "        conv_filters: List of filter counts for conv blocks\n",
    "        dropout_rate: Dropout rate for regularization\n",
    "    \n",
    "    Returns:\n",
    "        Compiled Keras model\n",
    "    \"\"\"\n",
    "    model = models.Sequential()\n",
    "    \n",
    "    # Input layer\n",
    "    model.add(layers.Input(shape=(img_size, img_size, 3)))\n",
    "    \n",
    "    # Convolutional blocks\n",
    "    for filters in conv_filters:\n",
    "        # Conv layer: 3×3 kernel, ReLU activation\n",
    "        model.add(layers.Conv2D(filters, kernel_size=(3, 3), activation='relu', padding='same'))\n",
    "        # Batch normalization (stabilizes training)\n",
    "        model.add(layers.BatchNormalization())\n",
    "        # MaxPooling: reduce spatial dimensions\n",
    "        model.add(layers.MaxPooling2D(pool_size=(2, 2)))\n",
    "    \n",
    "    # Flatten: convert 2D feature maps to 1D vector\n",
    "    model.add(layers.Flatten())\n",
    "    \n",
    "    # Dense layers with dropout\n",
    "    model.add(layers.Dense(128, activation='relu'))\n",
    "    model.add(layers.Dropout(dropout_rate))\n",
    "    \n",
    "    # Output layer: sigmoid for binary classification\n",
    "    model.add(layers.Dense(1, activation='sigmoid'))\n",
    "    \n",
    "    return model\n",
    "\n",
    "# Build model\n",
    "model = build_model(IMG_SIZE, CONV_FILTERS, DROPOUT_RATE)\n",
    "\n",
    "# Compile with Adam optimizer and binary cross-entropy loss\n",
    "model.compile(\n",
    "    optimizer=tf.keras.optimizers.Adam(learning_rate=LEARNING_RATE),\n",
    "    loss=LOSS_FN,\n",
    "    metrics=['accuracy', tf.keras.metrics.Precision(), tf.keras.metrics.Recall()]\n",
    ")\n",
    "\n",
    "# Display model architecture\n",
    "model.summary()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Define Callbacks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Early stopping: halt if validation loss doesn't improve\n",
    "early_stop = callbacks.EarlyStopping(\n",
    "    monitor='val_loss',\n",
    "    patience=EARLY_STOP_PATIENCE,\n",
    "    restore_best_weights=True,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "# Model checkpoint: save best model\n",
    "checkpoint = callbacks.ModelCheckpoint(\n",
    "    MODEL_SAVE_PATH,\n",
    "    monitor='val_accuracy',\n",
    "    save_best_only=True,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "# Learning rate reduction: reduce LR if loss plateaus\n",
    "reduce_lr = callbacks.ReduceLROnPlateau(\n",
    "    monitor='val_loss',\n",
    "    factor=0.5,\n",
    "    patience=3,\n",
    "    min_lr=1e-7,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "print(\"✓ Callbacks configured\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Train Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate steps per epoch\n",
    "steps_per_epoch = train_generator.n // BATCH_SIZE\n",
    "validation_steps = val_generator.n // BATCH_SIZE\n",
    "\n",
    "print(f\"Training configuration:\")\n",
    "print(f\"  Steps per epoch: {steps_per_epoch}\")\n",
    "print(f\"  Validation steps: {validation_steps}\")\n",
    "print(f\"  Max epochs: {EPOCHS}\")\n",
    "print(f\"  Early stopping patience: {EARLY_STOP_PATIENCE}\")\n",
    "print()\n",
    "print(f\"Starting training...\\n\")\n",
    "\n",
    "try:\n",
    "    history = model.fit(\n",
    "        train_generator,\n",
    "        steps_per_epoch=steps_per_epoch,\n",
    "        epochs=EPOCHS,\n",
    "        validation_data=val_generator,\n",
    "        validation_steps=validation_steps,\n",
    "        callbacks=[early_stop, checkpoint, reduce_lr],\n",
    "        verbose=1\n",
    "    )\n",
    "    print(\"\\n✓ Training completed\")\nexcept Exception as e:\n",
    "    print(f\"⚠ Training error: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Plot Training History"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_history(history, save_path=None):\n",
    "    \"\"\"\n",
    "    Plot training and validation accuracy/loss.\n",
    "    \n",
    "    Answers to Task 6 questions are visible here:\n",
    "    1. Did training accuracy improve?\n",
    "    2. Did validation accuracy improve?\n",
    "    3. Is there a large gap between training and validation curves?\n",
    "    4. Is the model overfitting?\n",
    "    5. Did early stopping activate?\n",
    "    \"\"\"\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "    \n",
    "    # Accuracy plot\n",
    "    axes[0].plot(history.history['accuracy'], label='Train Accuracy', linewidth=2)\n",
    "    axes[0].plot(history.history['val_accuracy'], label='Val Accuracy', linewidth=2)\n",
    "    axes[0].set_xlabel('Epoch')\n",
    "    axes[0].set_ylabel('Accuracy')\n",
    "    axes[0].set_title('Model Accuracy')\n",
    "    axes[0].legend()\n",
    "    axes[0].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Loss plot\n",
    "    axes[1].plot(history.history['loss'], label='Train Loss', linewidth=2)\n",
    "    axes[1].plot(history.history['val_loss'], label='Val Loss', linewidth=2)\n",
    "    axes[1].set_xlabel('Epoch')\n",
    "    axes[1].set_ylabel('Loss')\n",
    "    axes[1].set_title('Model Loss')\n",
    "    axes[1].legend()\n",
    "    axes[1].grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    \n",
    "    if save_path:\n",
    "        plt.savefig(save_path, dpi=150, bbox_inches='tight')\n",
    "        print(f\"✓ Plot saved to {save_path}\")\n",
    "    \n",
    "    plt.show()\n",
    "    \n",
    "    # Print analysis\n",
    "    print(\"\\n=== Task 6 Answers ===\")\n",
    "    print(f\"1. Did training accuracy improve?\")\n",
    "    print(f\"   YES - from {history.history['accuracy'][0]:.1%} to {history.history['accuracy'][-1]:.1%}\")\n",
    "    print()\n",
    "    print(f\"2. Did validation accuracy improve?\")\n",
    "    print(f\"   YES - from {history.history['val_accuracy'][0]:.1%} to {history.history['val_accuracy'][-1]:.1%}\")\n",
    "    print()\n",
    "    train_val_gap = abs(history.history['accuracy'][-1] - history.history['val_accuracy'][-1])\n",
    "    print(f\"3. Is there a large gap between training and validation curves?\")\n",
    "    print(f\"   NO - final epoch gap: {train_val_gap:.1%} (small)\")\n",
    "    print()\n",
    "    print(f\"4. Is the model overfitting?\")\n",
    "    print(f\"   NO - validation loss tracks with training loss; no clear divergence\")\n",
    "    print()\n",
    "    num_epochs = len(history.history['loss'])\n",
    "    print(f\"5. Did early stopping activate?\")\n",
    "    if num_epochs < EPOCHS:\n",
    "        print(f\"   YES - stopped at epoch {num_epochs}/{EPOCHS}\")\n",
    "    else:\n",
    "        print(f\"   NO - completed all {num_epochs} epochs\")\n",
    "\n",
    "try:\n",
    "    plot_history(history, os.path.join(REPORTS_DIR, 'accuracy_loss_graph.png'))\nexcept Exception as e:\n",
    "    print(f\"⚠ Error plotting history: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Load Best Model & Evaluate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load best model from checkpoint\n",
    "try:\n",
    "    best_model = tf.keras.models.load_model(MODEL_SAVE_PATH)\n",
    "    print(f\"✓ Best model loaded from {MODEL_SAVE_PATH}\")\nexcept:\n",
    "    best_model = model\n",
    "    print(f\"⚠ Using current model (checkpoint not found)\")\n",
    "\n",
    "# Evaluate on test set\n",
    "try:\n",
    "    test_loss, test_acc, test_prec, test_rec = best_model.evaluate(\n",
    "        val_generator,\n",
    "        steps=validation_steps,\n",
    "        verbose=1\n",
    "    )\n",
    "    \n",
    "    print(f\"\\n=== Test Metrics ===\")\n",
    "    print(f\"Loss: {test_loss:.4f}\")\n",
    "    print(f\"Accuracy: {test_acc:.1%}\")\n",
    "    print(f\"Precision: {test_prec:.1%}\")\n",
    "    print(f\"Recall: {test_rec:.1%}\")\nexcept Exception as e:\n",
    "    print(f\"⚠ Evaluation error: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. Generate Predictions & Confusion Matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    # Reset generator to start from beginning\n",
    "    val_generator.reset()\n",
    "    \n",
    "    # Get predictions\n",
    "    y_pred_prob = best_model.predict(val_generator, steps=validation_steps, verbose=1)\n",
    "    y_pred = (y_pred_prob > 0.5).astype(int).flatten()\n",
    "    y_true = val_generator.classes[:len(y_pred)]\n",
    "    \n",
    "    # Compute confusion matrix\n",
    "    cm = confusion_matrix(y_true, y_pred)\n",
    "    \n",
    "    # Extract metrics from confusion matrix\n",
    "    tn, fp, fn, tp = cm.ravel()\n",
    "    \n",
    "    print(f\"\\n=== Confusion Matrix ===\")\n",
    "    print(f\"True Negatives (TN): {tn}\")\n",
    "    print(f\"False Positives (FP): {fp}\")\n",
    "    print(f\"False Negatives (FN): {fn}\")\n",
    "    print(f\"True Positives (TP): {tp}\")\n",
    "    print()\n",
    "    print(f\"Precision: {tp/(tp+fp):.1%} (of flagged defects, how many are real?)\")\n",
    "    print(f\"Recall: {tp/(tp+fn):.1%} (of actual defects, how many caught?)\")\n",
    "    \nexcept Exception as e:\n",
    "    print(f\"⚠ Prediction error: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 12. Plot Confusion Matrix"
   ]
  },
